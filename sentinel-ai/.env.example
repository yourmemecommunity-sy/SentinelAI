# SentinelAI environment template. Copy to .env (git-ignored). NEVER commit real values.
NODE_ENV=development

# --- API gateway ---
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-32
API_KEY_HASH_PEPPER=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Open self-service signup: default true in development, false in production.
SIGNUP_ENABLED=
ENCRYPTION_KEY=change-me-32-byte-hex-for-provider-credential-encryption

# --- Data stores ---
DATABASE_URL=postgresql://sentinel:sentinel_dev_password@postgres:5432/sentinel
REDIS_URL=redis://redis:6379

# --- Object storage (S3-compatible; MinIO locally) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=sentinel-files
S3_ACCESS_KEY=minio-dev-access
S3_SECRET_KEY=minio-dev-secret

# --- Internal services ---
SECURITY_ENGINE_URL=http://security-engine:8001
POLICY_ENGINE_URL=http://policy-engine:8002
DOCUMENT_SCANNER_URL=http://document-scanner:8003
# Shared secret between the gateway and the document scanner (>= 16 chars; required in production).
DOCUMENT_SCANNER_TOKEN=change-me-generate-with-openssl-rand-hex-32
DOCUMENT_SCANNER_TIMEOUT_MS=60000
# Largest accepted upload, in bytes (gateway and scanner both enforce it). Default 20 MiB.
MAX_FILE_BYTES=20971520
AI_ROUTER_URL=http://ai-router:4100
SECURITY_TIMEOUT_MS=2000
# Fail-closed is not configurable off in production.

# --- Document scanner service (services/document-scanner reads these; DOCUMENT_SCANNER_TOKEN above is DOC_SCANNER_TOKEN there) ---
DOC_SCANNER_TOKEN=change-me-same-value-as-DOCUMENT_SCANNER_TOKEN
# "clamd" (real AV, required in production) or "eicar" (dev-only baseline that recognises only the EICAR test file).
MALWARE_SCANNER=eicar
CLAMD_HOST=clamav
CLAMD_PORT=3310
# Path/name of the tesseract binary; images are BLOCKED when OCR is unavailable.
TESSERACT_CMD=
MAX_TEXT_CHARS=450000
MAX_PDF_PAGES=500
EXTRACT_TIMEOUT_S=20

# --- Token vault (reversible tokenization; services/token-vault) ---
VAULT_URL=http://token-vault:8004
# Shared secret: gateway -> vault and engine -> vault (>= 16 chars; required in production).
VAULT_TOKEN=change-me-generate-with-openssl-rand-hex-32
VAULT_TIMEOUT_MS=1000
# Vault service only: comma-separated id:base64 pairs, each key >= 32 bytes (openssl rand -base64 32). Required in production.
VAULT_MASTER_KEYS=
VAULT_ACTIVE_KEY=
VAULT_TTL_SECONDS=3600
# Streaming (gateway): look-ahead scanned before text is released, idle/total limits, per-caller concurrency.
STREAM_HOLDBACK_CHARS=256
STREAM_MIN_SEGMENT_CHARS=64
STREAM_IDLE_TIMEOUT_MS=30000
STREAM_MAX_DURATION_MS=300000
STREAM_MAX_OUTPUT_CHARS=200000
STREAM_MAX_CONCURRENT=10

# --- Provider credentials (per-org credentials are stored encrypted in DB; these are dev fallbacks) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama is registered only when BOTH OLLAMA_BASE_URL and OLLAMA_MODEL are set. The URL is operator config, never request data.
OLLAMA_MODEL=

# --- Privacy ---
ZERO_RETENTION_MODE=false
AUDIT_RETENTION_DAYS=90
